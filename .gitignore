/node_modules
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts
.DS_Store
npm-debug.log*

# raw の実データは原本アーカイブとしてコミットする（発行元がファイルを差し替え・
# 削除してもエビデンスを検証できるように）。フィクスチャの raw だけは生成物なので追跡しない
/data/raw/fixture-*/
.vercel
.env*

# 一次資料 PDF の配信コピー（data/raw から bun pipeline/sync-public-sources.ts が生成）
/public/sources/
/public/vendor/

# pipeline:archive の実行中ロックと、git の外で動くときの状態（pipeline/lib/archive-state.ts）
/data/.archive.lock
/data/.archive-state/
/data/archives.json.*.tmp
