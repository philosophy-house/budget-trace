{
  "name": "yosan-trace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun pipeline/sync-public-sources.ts && next dev",
    "build": "bun pipeline/sync-public-sources.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "pipeline:fetch": "bun pipeline/fetch.ts",
    "pipeline:ingest": "bun pipeline/ingest-local.ts",
    "pipeline:try-council": "bun pipeline/try-council.ts",
    "pipeline:try-parse": "bun pipeline/try-parse.ts",
    "pipeline:parse": "bun pipeline/parse.ts",
    "pipeline:validate": "bun pipeline/validate.ts",
    "pipeline:normalize": "bun pipeline/normalize.ts",
    "pipeline:fixture": "bun pipeline/dev/make-fixture.ts",
    "pipeline:derive": "bun pipeline/derive-app-data.ts",
    "pipeline:archive": "bun pipeline/archive.ts",
    "pipeline:archive-attempts": "bun pipeline/archive-attempts.ts",
    "pipeline:inflight": "bun pipeline/inflight.ts",
    "worktree:slim": "bun pipeline/worktree-raw.ts slim",
    "worktree:raw": "bun pipeline/worktree-raw.ts"
  },
  "dependencies": {
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vanilla-cookieconsent": "3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "5.5.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "//": "next 16.4.6 が postcss 8.5.23・sharp ^0.35.5 を自分で要求するようになったので、以前あった postcss と sharp の overrides は外した（2026-11-17。残すと古い版に留めてしまう）。下の2つは next が連れてくる間接依存で、lock が脆弱性のある版に留まるため、直った版へ上げている",
    "//source-map-js": "next › postcss › source-map-js。1.2.2 未満に GHSA-68fv-2mgg-jv7q。postcss の要求は ^1.2.1 なので範囲内",
    "source-map-js": "^1.2.2",
    "//baseline-browser-mapping": "next › baseline-browser-mapping。2.11.0 未満に GHSA-w5vr-8v7q-w6rv。next を上げて lock が自然に 2.11 以上になったら外してよい",
    "baseline-browser-mapping": "^2.11.0"
  }
}
